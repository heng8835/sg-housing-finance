# copy to .env; every value is optional
HDB_PIPELINE_PROXY=                 # e.g. http://proxy.example:3128 (leave blank for a direct connection)
HDB_PIPELINE_DATA_DIR=              # defaults to ./data
HDB_PIPELINE_TIMEOUT_S=30
HDB_PIPELINE_GSHEETS_SHEET_ID=      # optional Google Sheets mirror
HDB_PIPELINE_GSHEETS_KEY_FILE=secrets/gsheets-service-account.json
